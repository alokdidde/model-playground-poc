{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "DATABASE_URL"
      ]
    },
    "generate": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^generate"
      ],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL"
      ]
    },
    "lint": {},
    "dev": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
