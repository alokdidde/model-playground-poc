# ---- Database (DO Managed Postgres in prod, docker compose locally) ----
DATABASE_URL=postgresql://fomo:fomo@localhost:5432/fomo

# ---- DigitalOcean serverless inference (OpenAI-compatible) ----
# Leave DO_MODEL_ACCESS_KEY empty (or set GRADIENT_MOCK=1) to use canned mock responses.
GRADIENT_BASE_URL=https://inference.do-ai.run/v1
DO_MODEL_ACCESS_KEY=
GRADIENT_MOCK=1
# Mock knobs: fraction of mock calls that fail with 429 / 500 (to demo retries and partial results)
MOCK_429_RATE=0.15
MOCK_ERROR_RATE=0.05

# ---- Judge ----
JUDGE_MODEL=openai-gpt-oss-120b
# Used when the preferred judge is one of the compared models (keeps the judge neutral)
JUDGE_FALLBACK_MODELS=deepseek-v4.1-flash,glm-5.3-flash

# ---- Rate limiting (token + request leasing) ----
# postgres (default: shared by every web instance) | memory (single process, tests)
LEASE_STORE=postgres
# Fallback limits per model, used until the first response's x-ratelimit-* headers
# teach the real ones (DO: 120 requests/min per model, 1M-1.5M tokens/min).
RATE_LIMIT_RPM=100
RATE_LIMIT_TPM=1000000
RATE_LIMIT_MAX_IN_FLIGHT=16
# model = one budget per (access key, model), how DO counts; account = one per key
RATE_LIMIT_BUCKET=model
# Record every rate-limit decision in the rate_event table (drawn at /ops/rate-limits). "off" disables it.
RATE_EVENTS=on
