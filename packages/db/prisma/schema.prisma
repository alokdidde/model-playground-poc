// Application data: comparisons, judgements, votes, the rate-limit lease store and its event log.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev, debian-openssl-3.0.x for the node:22-slim Docker images
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL // finished, but at least one model call failed
  FAILED
  CANCELLED
}

enum CallStatus {
  SUCCEEDED
  FAILED
}

// ---------------------------------------------------------------------------
// Interactive compare
// ---------------------------------------------------------------------------

model Comparison {
  id             String          @id @default(cuid())
  prompt         String
  systemPrompt   String?
  models         String[]
  maxTokens      Int
  temperature    Float
  /// general | coding | reasoning | writing | summarization | extraction | chat
  taskType       String          @default("general")
  /// The user's stated {quality, cost, speed} weights, if any
  priority       Json?
  status         RunStatus       @default(RUNNING)
  /// Optional client-supplied key; a retried POST with the same key is rejected with 409.
  idempotencyKey String?         @unique
  requestId      String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  /// One merged answer written by a neutral model, citing which model each part came from.
  synthesis      String?
  synthesisModel String?
  results        CompareResult[]
  judgement      Judgement?
  vote           Vote?

  @@index([createdAt])
}

model CompareResult {
  id              String     @id @default(cuid())
  comparisonId    String
  comparison      Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  model           String
  status          CallStatus
  output          String
  /// The settings actually sent to this model (temperature, topP, maxTokens, reasoningEffort, systemPrompt)
  settings        Json?
  /// The user's thumbs up (1) or down (-1) on this answer, if any.
  rating          Int?
  /// RFC 9457 problem, when status = FAILED
  problem         Json?
  latencyMs       Int
  ttftMs          Int?
  /// Output tokens/sec from the first streamed chunk (includes reasoning tokens)
  outputTokensPerSec Float?
  /// The model streamed reasoning before answering
  reasoned        Boolean?
  inputTokens     Int
  outputTokens    Int
  tokensEstimated Boolean
  costUsd         Float?
  attempts        Int
  /// Set when a reasoning model ran out of tokens and was retried with this bigger max_tokens
  maxTokensRaisedTo Int?
  createdAt       DateTime   @default(now())

  @@unique([comparisonId, model])
  @@index([model])
}

model Judgement {
  id           String     @id @default(cuid())
  comparisonId String     @unique
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  judgeModel   String
  selfJudged   Boolean
  winnerModel  String?
  rationale    String
  /// JudgeScore[]
  scores       Json
  latencyMs    Int
  costUsd      Float?
  /// How many answer orders the judge scored (2 = forward and reversed).
  orders       Int        @default(1)
  /// Both orders picked the same winner; false = position flip, counted as a tie.
  positionConsistent Boolean?
  createdAt    DateTime   @default(now())
}

/// A human preference. These are the seed data for the "learn from votes" roadmap item.
model Vote {
  id             String     @id @default(cuid())
  comparisonId   String     @unique
  comparison     Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  preferredModel String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Rate limiting: the Postgres lease store (see packages/ratelimit)
// ---------------------------------------------------------------------------

/// One row per granted lease. A lease reserves 1 request and N estimated tokens
/// in a sliding window; it is reconciled with real usage when the call finishes.
model RateLease {
  id             String    @id
  bucket         String
  tokensReserved Int       @map("tokens_reserved")
  tokensActual   Int?      @map("tokens_actual")
  createdAt      DateTime  @default(now()) @map("created_at")
  /// In-flight leases count toward the concurrency cap until released or expired.
  expiresAt      DateTime  @map("expires_at")
  releasedAt     DateTime? @map("released_at")

  @@index([bucket, createdAt])
  @@map("rate_lease")
}

/// Set when the provider returns 429, so every instance backs off, not just the one that got it.
model RateCooldown {
  bucket String   @id
  until  DateTime

  @@map("rate_cooldown")
}

/// What the rate limiter and the gateway did, one row per event: leases granted
/// and waited for, 429s, cooldowns, learned limits, AIMD factor changes, retries
/// (with the backoff and jitter actually used) and attempt outcomes.
/// Written in small batches by PostgresEventSink; /ops/rate-limits draws it as a timeline.
model RateEvent {
  id      BigInt   @id @default(autoincrement())
  at      DateTime @default(now()) @db.Timestamptz(3)
  /// web | script: which process emitted it
  source  String
  /// See RateEventKind in packages/ratelimit/src/events.ts
  kind    String
  model   String?
  /// Correlates events with a run: the comparison id
  tag     String?
  attempt Int?
  /// The headline duration for this kind: time waited, retry delay, cooldown length, latency
  ms      Int?
  /// Everything else (bucket levels, effective limits, headers, jitter parts)
  data    Json?

  @@index([at])
  @@index([tag, at])
  @@map("rate_event")
}
